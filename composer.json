{
    "name": "rmunate/laravel_helpers",
    "description": "Generate application helpers and extend Laravel's native helper classes.",
    "keywords": [
        "rmunate",
        "artisan",
        "laravel",
        "helpers"
    ],
    "homepage": "https://github.com/rmunate/LaravelHelpers",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Helpers\\Illuminate\\Support\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Raul Mauricio Uñate Castro",
            "email": "raulmauriciounate@gmail.com",
            "homepage": "https://github.com/rmunate",
            "role": "owner"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "ext-tokenizer": "*",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/framework": "^12.0 || ^13.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "suggest": {
        "ext-intl": "Required by Laravel for locale-aware Number helpers."
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "4.x-dev"
        },
        "laravel": {
            "providers": [
                "Helpers\\Illuminate\\Support\\Providers\\HelpersServiceProvider"
            ]
        }
    }
}
